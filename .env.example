# Traefik / Let's Encrypt
ACME_EMAIL=your-email@example.com
DOMAIN=example.com

# Obsidian Sync credentials
OBSIDIAN_EMAIL=your-obsidian-email@example.com
OBSIDIAN_PASSWORD=your-account-password
VAULT_PASSWORD=your-vault-encryption-password
VAULT_NAME=My-Vault

# API Security — bearer token used between obsidian-mcp <-> obsidian-api,
# and (optionally) accepted as a static bearer on the MCP server itself for
# non-browser clients like curl or MCP Inspector.
API_TOKEN=your-secure-random-token-here

# API Ports (usually no need to change)
OBSIDIAN_API_PORT=3000

# OAuth 2.1 (for Claude.ai custom connectors)
# Set MCP_AUTH_ENABLED=false to disable OAuth entirely and fall back to API_TOKEN only.
MCP_AUTH_ENABLED=true
# Password the user types on the /authorize page when Claude.ai redirects them.
MCP_USER_PASSWORD=change-me-to-a-strong-secret
# Access-token lifetime (seconds) and refresh-token lifetime (days).
MCP_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TTL_DAYS=14
# MCP_PUBLIC_URL is derived from DOMAIN as https://mcp.${DOMAIN} in compose;
# override here only if you front this service with a different hostname.
# MCP_PUBLIC_URL=https://mcp.example.com
